# Copy this file to .env and fill in the real values. .env is gitignored.
#
# Development runs against Postgres on this machine, not Supabase. Supabase is a
# free nano instance in Singapore: every idle socket it drops surfaces as
# "Connection terminated unexpectedly" mid-page, which is miserable to develop
# against and tells you nothing about your own code. Local is also safe to wipe.
#
#   .env             -> local Postgres. Used by `next dev` and every prisma CLI command.
#   .env.production  -> Supabase. Used by `next build` / `next start` only.
#
# Create the local database once (psql is in C:\Program Files\PostgreSQL\18\bin):
#   createdb -U postgres bizbook_dev
#   npx prisma migrate dev
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/bizbook_dev"

# To run a migration against Supabase instead, override for that one command
# (PowerShell) — the CLI only ever reads .env, so it needs telling explicitly:
#   $env:DATABASE_URL="<supabase-uri>"; npx prisma migrate deploy; $env:DATABASE_URL=$null

# Signs the session cookie, so it must be long, random and secret — anyone who
# knows it can forge a login. Required in production; a development machine
# falls back to a built-in value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it signs everybody out, which is also how you revoke every session.
AUTH_SECRET="paste-a-long-random-string-here"
