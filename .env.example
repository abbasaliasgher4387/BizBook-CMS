# Copy this file to .env and fill in the real values. .env is gitignored.
#
# Development runs against Postgres on this machine, not Supabase. Supabase is a
# free nano instance in Singapore: every idle socket it drops surfaces as
# "Connection terminated unexpectedly" mid-page, which is miserable to develop
# against and tells you nothing about your own code. Local is also safe to wipe.
#
#   .env             -> local Postgres. Used by `next dev` and every prisma CLI command.
#   .env.production  -> Supabase. Used by `next build` / `next start` only.
#
# Create the local database once (psql is in C:\Program Files\PostgreSQL\18\bin):
#   createdb -U postgres bizbook_dev
#   npx prisma migrate dev
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/bizbook_dev"

# To run a migration against Supabase by hand, override for that one command
# (PowerShell) — the CLI only ever reads .env, so it needs telling explicitly:
#   $env:DATABASE_URL="<supabase-uri>"; npx prisma migrate deploy; $env:DATABASE_URL=$null
#
# `npm run build` now runs `prisma migrate deploy` too, so a deployment applies
# its own pending migrations and cannot ship code against an older schema. On
# Vercel that reads the DATABASE_URL set in the project's Environment Variables;
# on this machine it reads the line above, so a local build migrates the local
# database and never touches Supabase. It only ever runs the files in
# prisma/migrations — schema, no rows. Demo data comes from `prisma db seed`,
# which nothing but you ever runs.

# Signs the session cookie, so it must be long, random and secret — anyone who
# knows it can forge a login. Required in production; a development machine
# falls back to a built-in value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it signs everybody out, which is also how you revoke every session.
AUTH_SECRET="paste-a-long-random-string-here"

# The site's own address, e.g. https://bizbook.example. PDF downloads point a
# headless browser at it, and it deliberately does NOT come from the request's
# Host header: that header is typed by whoever is calling, and the browser
# fetching the URL is carrying their session. On Vercel it is filled in from
# VERCEL_URL automatically; set it anywhere else. Development uses localhost.
# APP_ORIGIN="https://bizbook.example"

# Read once, on a database with no users at all: the password the first
# `administrator` account is created with. Required in production — without it a
# fresh deployment would stand up an account whose password is in the source.
# Sign in with it, change it from My account, and it is never read again.
# ADMIN_PASSWORD="a-password-you-choose"
