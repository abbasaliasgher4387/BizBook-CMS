// Phase 1: quotations and bills. No chart of accounts, no double entry, no FBR.
// Money is always Decimal — never Float. Float loses paisa.
//
// Fields come from the client's own bill formats and letterheads. Every company
// gets the same fields; only the printed design differs.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

// Two levels only: ADMIN also manages the accounts, USER does the day's work.
model User {
  id       String @id @default(cuid())
  // Stored lowercase — "Administrator" and "administrator" are one account.
  username String @unique
  name     String?
  // scrypt, "salt:key" in hex. See src/lib/auth.ts.
  passwordHash String
  role         Role    @default(USER)
  // Switched off rather than deleted, so an account can be revoked without
  // losing the record that it existed.
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One of the client's registered companies. More can be added any time.
model Company {
  id   String @id @default(cuid())
  name String
  // Prefix used in this company's quotation numbers, e.g. "SAMS" -> SAMS-0001
  code String @unique

  // Letterhead content. Each company's real letterhead carries a different
  // subset — blank fields simply do not print.
  tagline    String? // "Deals in all kind of hardware items, ..."
  headerNote String? // AMS prints "Insha Allah" in the top corner
  address    String?
  phone      String?
  email      String?
  ntn        String?
  strn       String?
  gstNumber  String?
  // Real logo file dropped into /public, e.g. "/logos/sams.png". When empty the
  // template draws its own CSS/SVG mark instead.
  logoUrl    String?

  // Which design this company prints on — the same one serves its quotations
  // and its bills. Keys live in src/lib/quotation-templates/index.ts.
  templateKey String @default("sams")

  // 0 = charges none, and the bill form offers no GST row. Overridable per bill.
  defaultGstPercent Decimal @default(0) @db.Decimal(5, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations Quotation[]
  bills      Bill[]
}

// Shared across all companies — the same customer can buy from any of them.
model Customer {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  ntn           String?
  gstNumber     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quotations Quotation[]
  bills      Bill[]

  @@index([name])
}

// Shared across all companies.
model Product {
  id          String   @id @default(cuid())
  name        String
  code        String?  @unique
  unit        String   @default("pcs") // pcs, kg, ft, sheet, ...
  defaultRate Decimal  @db.Decimal(14, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items     QuotationItem[]
  billItems BillItem[]

  @@index([name])
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id String @id @default(cuid())
  // Sequence within its own company, zero padded: "0001". The company code is
  // printed separately by the template, so it is not repeated here.
  number     String
  companyId  String
  customerId String
  date       DateTime        @default(now())
  validUntil DateTime?
  status     QuotationStatus @default(DRAFT)

  // The client's bills carry these two references; both are optional because
  // not every company's format prints them.
  poNumber String? // "PO # 10102682/2025"
  dcNumber String? // delivery challan

  notes String?
  terms String?

  // Stored, not computed on read: a quotation is a record of what was actually
  // quoted, so later rate or GST changes must not rewrite history.
  subtotal   Decimal @default(0) @db.Decimal(14, 2)
  gstPercent Decimal @default(0) @db.Decimal(5, 2) // 0 = no GST line on the document
  gstAmount  Decimal @default(0) @db.Decimal(14, 2)
  cartage    Decimal @default(0) @db.Decimal(14, 2) // freight, 0 = hidden
  total      Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])
  items    QuotationItem[]
  // Not constrained to one: an order shipped in parts is billed in parts.
  bills    Bill[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([customerId])
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  // Optional: a line can be typed by hand for something not in the catalogue.
  productId   String?
  // Snapshot of the name/unit/rate at quoting time — renaming a product later
  // must not change what an old quotation says.
  description String
  unit        String
  quantity    Decimal @db.Decimal(14, 3)
  rate        Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)
  sortOrder   Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@index([quotationId])
}

enum BillStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

/// A bill starts life as a copy of an accepted quotation — copy, not a link:
/// editing that quotation next month must not rewrite a bill already in the
/// customer's hands. `quotationId` records where it came from, nothing more.
///
/// The difference from a quotation is the charges: cartage, GST, labour,
/// discount — see BillCharge.
model Bill {
  id String @id @default(cuid())
  // Sequence within its own company, zero padded, and separate from the
  // quotation sequence. Printed as SAMS-B-0001 so it is never mistaken for
  // quotation SAMS-0001.
  number      String
  companyId   String
  customerId  String
  // Null when the bill was typed from scratch rather than billed from a
  // quotation. Survives the quotation being deleted — see onDelete below.
  quotationId String?

  date    DateTime   @default(now())
  dueDate DateTime?
  status  BillStatus @default(DRAFT)

  poNumber String?
  dcNumber String?
  notes    String?
  terms    String?

  // Stored, not computed on read, for the same reason as on a quotation: this
  // is a record of what was charged.
  subtotal     Decimal @default(0) @db.Decimal(14, 2) // lines only
  chargesTotal Decimal @default(0) @db.Decimal(14, 2) // every BillCharge added up
  total        Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  customer  Customer   @relation(fields: [customerId], references: [id])
  // SetNull, not Cascade: a bill is its own document. Deleting the quotation it
  // came from loses the cross-reference, never the bill.
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  items   BillItem[]
  charges BillCharge[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([customerId])
  @@index([quotationId])
}

model BillItem {
  id        String  @id @default(cuid())
  billId    String
  productId String?
  // Snapshot, as on a quotation line.
  description String
  unit        String
  quantity    Decimal @db.Decimal(14, 3)
  rate        Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)
  sortOrder   Int     @default(0)

  bill    Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([billId])
}

/// Anything added to the lines: GST, cartage, labour, or a negative discount.
/// A table rather than fixed columns because the client's own bill formats
/// disagree about which charges exist — the next one should cost a row, not a
/// migration.
model BillCharge {
  id     String @id @default(cuid())
  billId String
  label  String // printed as-is: "GST 18%", "Cartage", "Discount"
  // Set when the charge is a percentage of the subtotal; null when it is a flat
  // figure. Kept so re-opening the bill shows "18" in the % box again.
  percent Decimal? @db.Decimal(5, 2)
  // Always stored, even for a percentage: resolved once at save time, so a later
  // edit to the lines never silently restates an issued bill.
  amount    Decimal @db.Decimal(14, 2)
  sortOrder Int     @default(0)

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}
